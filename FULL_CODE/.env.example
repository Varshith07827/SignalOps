# Copy this file to FULL_CODE/.env and change the values. FULL_CODE/.env is git-ignored.
# Demo passwords for the accounts db/seed.py creates (at least 8 characters).
VOS_ADMIN_PASSWORD=change-me-admin
VOS_STORE_PASSWORD=change-me-store
# Optional overrides:
# VOS_CONFIG=config.toml        # path to an alternative settings file
# VOS_LOG_LEVEL=INFO            # DEBUG, INFO, WARNING, ERROR
